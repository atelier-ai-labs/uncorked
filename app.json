{
  "expo": {
    "name": "Uncorked",
    "slug": "uncorked",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12090C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nmagera.uncorked",
      "infoPlist": {
        "NSCameraUsageDescription": "Uncorked uses your camera to scan wine bottle labels and identify vintages.",
        "NSPhotoLibraryUsageDescription": "Uncorked uses your photo library so you can import wine bottle photos."
      }
    },
    "android": {
      "package": "com.nmagera.uncorked",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Uncorked to access your photos to analyze wine labels.",
          "cameraPermission": "Allow Uncorked to use your camera to scan wine bottle labels.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6d014fad-82e1-4013-a88a-a82cc21871d2"
      }
    },
    "owner": "atelier-ai-labs",
    "updates": {
      "url": "https://u.expo.dev/6d014fad-82e1-4013-a88a-a82cc21871d2"
    }
  }
}
